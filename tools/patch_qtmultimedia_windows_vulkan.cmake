if(NOT DEFINED MULTIMEDIA_SOURCE_DIR)
    message(FATAL_ERROR "Pass -DMULTIMEDIA_SOURCE_DIR=<Qt Multimedia source>")
endif()
set(video_window "${MULTIMEDIA_SOURCE_DIR}/src/multimedia/video/qvideowindow.cpp")
if(NOT EXISTS "${video_window}")
    message(FATAL_ERROR "Qt Multimedia Windows video source not found: ${video_window}")
endif()
file(READ "${video_window}" video_source)
if(video_source MATCHES "#if QT_CONFIG\\(vulkan\\) && __has_include")
    return()
endif()
if(NOT video_source MATCHES "#if QT_CONFIG\\(vulkan\\)")
    message(FATAL_ERROR "Qt Multimedia Vulkan guard changed; review the local source compatibility patch")
endif()
string(REPLACE "#if QT_CONFIG(vulkan)" "#if QT_CONFIG(vulkan) && __has_include(<vulkan/vulkan.h>)" video_source "${video_source}")
file(WRITE "${video_window}" "${video_source}")
