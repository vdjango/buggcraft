# Build-only sidecar assets; executable embeds metadata, never all QM payloads.
cmake_minimum_required(VERSION 3.24)
file(STRINGS "${CATALOGS}" language_catalogs)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(language_packs "{}")
foreach(language_catalog IN LISTS language_catalogs)
    get_filename_component(language_stem "${language_catalog}" NAME_WE)
    string(REGEX REPLACE "^bugg_" "" language_code "${language_stem}")
    if(NOT language_code MATCHES "^[a-z][a-z0-9_]+$")
        message(FATAL_ERROR "Invalid language catalog: ${language_stem}")
    endif()
    set(language_path "${INPUT_DIR}/${language_stem}.qm")
    file(SIZE "${language_path}" language_size)
    if(language_size LESS 1 OR language_size GREATER 262144)
        message(FATAL_ERROR "Language pack exceeds runtime bound: ${language_code}")
    endif()
    file(SHA1 "${language_path}" language_sha1)
    file(SHA256 "${language_path}" language_sha256)
    set(language_asset "Bugg-language-${language_sha256}.qm")
    file(COPY_FILE "${language_path}" "${OUTPUT_DIR}/${language_asset}" ONLY_IF_DIFFERENT)
    string(JSON language_entry SET "{}" file "\"${language_asset}\"")
    string(JSON language_entry SET "${language_entry}" size "${language_size}")
    string(JSON language_entry SET "${language_entry}" sha1 "\"${language_sha1}\"")
    string(JSON language_entry SET "${language_entry}" sha256 "\"${language_sha256}\"")
    string(JSON language_packs SET "${language_packs}" "${language_code}" "${language_entry}")
endforeach()
string(JSON language_manifest SET "{}" format 1)
string(JSON language_manifest SET "${language_manifest}" version "\"${VERSION}\"")
string(JSON language_manifest SET "${language_manifest}" packs "${language_packs}")
file(WRITE "${MANIFEST}.tmp" "${language_manifest}\n")
file(COPY_FILE "${MANIFEST}.tmp" "${MANIFEST}" ONLY_IF_DIFFERENT)
file(REMOVE "${MANIFEST}.tmp")
