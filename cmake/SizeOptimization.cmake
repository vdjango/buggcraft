# Optional release profile; keep portable CPU baselines and normal development builds.
option(BUGG_OPTIMIZE_SIZE "Optimize release code size and remove unreferenced code" OFF)
if(BUGG_OPTIMIZE_SIZE)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT BUGG_IPO_SUPPORTED OUTPUT BUGG_IPO_ERROR LANGUAGES C CXX)
    if(NOT BUGG_IPO_SUPPORTED)
        message(FATAL_ERROR "BUGG_OPTIMIZE_SIZE requires supported LTO: ${BUGG_IPO_ERROR}")
    endif()
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
    if(MSVC)
        add_compile_options("$<$<CONFIG:Release>:/O1>" "$<$<CONFIG:Release>:/Gy>" "$<$<CONFIG:Release>:/Gw>")
        add_link_options("$<$<CONFIG:Release>:/OPT:REF>" "$<$<CONFIG:Release>:/OPT:ICF>")
    else()
        add_compile_options("$<$<CONFIG:Release>:-Os>" "$<$<CONFIG:Release>:-ffunction-sections>" "$<$<CONFIG:Release>:-fdata-sections>")
        if(APPLE)
            add_link_options("$<$<CONFIG:Release>:-Wl,-dead_strip>")
        else()
            add_link_options("$<$<CONFIG:Release>:-Wl,--gc-sections>")
        endif()
    endif()
endif()
