# 开发期组件边界门禁；只检查页面/装配，DesignSystem 是通用控件唯一绘制所有者。
if(NOT DEFINED SOURCE_ROOT)
    get_filename_component(SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
get_filename_component(SOURCE_ROOT "${SOURCE_ROOT}" ABSOLUTE)
file(GLOB page_files "${SOURCE_ROOT}/qml/Bugg/Pages/*.qml")
list(APPEND page_files "${SOURCE_ROOT}/qml/Main.qml")
set(primitives "Rectangle|Text|Image|BorderImage|Canvas|Shape|AbstractButton|Button|ToolButton|TextField|TextArea|CheckBox|RadioButton|ComboBox|Popup|Dialog|MouseArea|TapHandler|HoverHandler")
foreach(path IN LISTS page_files)
    file(READ "${path}" source)
    if(source MATCHES "(^|[^A-Za-z0-9_.])(${primitives})[ \t\r\n]*\\{")
        message(FATAL_ERROR "${path}: 页面必须组合 Bugg.DesignSystem，禁止内联 ${CMAKE_MATCH_2}")
    endif()
endforeach()
file(READ "${SOURCE_ROOT}/qml/Bugg/DesignSystem/CMakeLists.txt" module_cmake)
file(READ "${SOURCE_ROOT}/qml/Bugg/DesignSystem/qmldir" module_registry)
file(GLOB components "${SOURCE_ROOT}/qml/Bugg/DesignSystem/*.qml")
foreach(path IN LISTS components)
    get_filename_component(name "${path}" NAME)
    string(FIND "${module_cmake}" "${name}" cmake_entry)
    string(FIND "${module_registry}" "${name}" registry_entry)
    if(cmake_entry LESS 0 OR registry_entry LESS 0)
        message(FATAL_ERROR "${name}: 组件必须同时注册到 CMake 与 qmldir")
    endif()
endforeach()
message(STATUS "QML 组件边界与注册检查通过")
