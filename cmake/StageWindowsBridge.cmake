# Copy the bridge PE import closure, never an SDK/developer bin directory.
cmake_minimum_required(VERSION 3.24)
foreach(bridge_argument SOURCE_BIN DESTINATION)
    if(NOT DEFINED ${bridge_argument})
        message(FATAL_ERROR "Missing ${bridge_argument}")
    endif()
endforeach()
file(REAL_PATH "${SOURCE_BIN}" bridge_source)
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE bridge_destination)
cmake_path(IS_PREFIX bridge_source "${bridge_destination}" NORMALIZE bridge_inside_source)
if(bridge_inside_source OR NOT EXISTS "${bridge_source}/buggcraft-bridge.exe")
    message(FATAL_ERROR "Bridge source must be a complete install bin outside destination")
endif()
find_program(bridge_dumpbin dumpbin HINTS "${LINKER_DIR}")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
if(bridge_dumpbin)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${bridge_dumpbin}")
else()
    find_program(bridge_objdump objdump HINTS "${LINKER_DIR}" REQUIRED)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${bridge_objdump}")
endif()
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${bridge_source}/buggcraft-bridge.exe"
    DIRECTORIES "${bridge_source}"
    RESOLVED_DEPENDENCIES_VAR bridge_dependencies
    UNRESOLVED_DEPENDENCIES_VAR bridge_unresolved
    PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
    POST_EXCLUDE_REGEXES "[/\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\]" "[/\\][Ss][Yy][Ss][Ww][Oo][Ww]64[/\\]")
if(bridge_unresolved)
    message(FATAL_ERROR "Missing bridge dependencies: ${bridge_unresolved}")
endif()
set(bridge_files "${bridge_source}/buggcraft-bridge.exe")
foreach(bridge_dependency IN LISTS bridge_dependencies)
    file(REAL_PATH "${bridge_dependency}" bridge_real)
    cmake_path(GET bridge_real PARENT_PATH bridge_parent)
    if(NOT bridge_parent STREQUAL bridge_source)
        message(FATAL_ERROR "Dependency not in the bridge install bin: ${bridge_real}")
    endif()
    list(APPEND bridge_files "${bridge_real}")
endforeach()
file(MAKE_DIRECTORY "${bridge_destination}")
set(bridge_manifest "")
foreach(bridge_file IN LISTS bridge_files)
    cmake_path(GET bridge_file FILENAME bridge_name)
    file(COPY_FILE "${bridge_file}" "${bridge_destination}/${bridge_name}" ONLY_IF_DIFFERENT)
    file(SHA256 "${bridge_destination}/${bridge_name}" bridge_sha)
    string(APPEND bridge_manifest "${bridge_sha}  ${bridge_name}\n")
endforeach()
file(WRITE "${bridge_destination}/runtime-files.sha256" "${bridge_manifest}")
message(STATUS "Staged bridge import closure at ${bridge_destination}")
